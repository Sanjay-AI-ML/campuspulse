# CampusPulse — AI provider config
# Copy this file to .env and fill in ONE of the keys below.
# The app picks the first available key in this order: Groq → Gemini → OpenRouter

# --- Option 1: Groq (recommended — fastest, free tier) ---
# Get your key at: https://console.groq.com
# Model used: llama-3.3-70b-versatile
GROQ_API_KEY=your_groq_api_key_here

# --- Option 2: Google Gemini (free tier) ---
# Get your key at: https://aistudio.google.com
# Model used: gemini-1.5-flash
# GEMINI_API_KEY=your_gemini_api_key_here

# --- Option 3: OpenRouter (fallback) ---
# Get your key at: https://openrouter.ai/keys
# Model used: openai/gpt-4o-mini
# OPENROUTER_API_KEY=your_openrouter_api_key_here
